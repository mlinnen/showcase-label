<Window x:Class="ShowcaseLabel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShowcaseLabel"
        mc:Ignorable="d"
        Title="Showcase Label Printer" Height="500" Width="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Event:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="EventComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Carver mode:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="SingleCarverRadioButton" Content="Single carver" IsChecked="True"
                         Checked="CarverMode_Checked" Margin="0,0,15,0"/>
            <RadioButton x:Name="RangeCarverRadioButton" Content="Carver range"
                         Checked="CarverMode_Checked"/>
        </StackPanel>

        <StackPanel x:Name="SingleCarverPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Carver ID:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="CarverIdTextBox" Width="150" Padding="5"
                     PreviewTextInput="NumericOnly_PreviewTextInput" DataObject.Pasting="NumericOnly_Pasting"/>
        </StackPanel>

        <Grid x:Name="RangeCarverPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
              Margin="0,0,0,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Start Carver ID:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="FromCarverIdTextBox" Grid.Column="1" Margin="0,0,15,0" Padding="5"
                     PreviewTextInput="NumericOnly_PreviewTextInput" DataObject.Pasting="NumericOnly_Pasting"/>
            <TextBlock Grid.Column="2" Text="End Carver ID:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="ToCarverIdTextBox" Grid.Column="3" Padding="5"
                     PreviewTextInput="NumericOnly_PreviewTextInput" DataObject.Pasting="NumericOnly_Pasting"/>
        </Grid>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Division:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="DivisionComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="From Entry:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="FromEntryTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="5" Text="1"
                 PreviewTextInput="NumericOnly_PreviewTextInput" DataObject.Pasting="NumericOnly_Pasting"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="To Entry:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="ToEntryTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" Padding="5" Text="1"
                 PreviewTextInput="NumericOnly_PreviewTextInput" DataObject.Pasting="NumericOnly_Pasting"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Printer:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="PrinterComboBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Label Size:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="LabelSizeComboBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

        <Button x:Name="PrintButton" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Content="Print Labels"
                Click="PrintButton_Click" Padding="10" Margin="0,10,0,10" Background="#007ACC" Foreground="White" FontWeight="Bold"/>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Text="Ready" Foreground="Gray" Margin="0,10,0,0"/>
    </Grid>
</Window>
